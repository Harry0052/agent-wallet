# Copy to .env.local. Every value here is a placeholder.

# ─── Required at startup (security/secretsManager.ts) ───────────────
DATABASE_URL=postgresql://user:password@localhost:5432/agent_wallet
AUTH_SESSION_SECRET=replace_with_at_least_32_characters
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PLAID_CLIENT_ID=replace_me
PLAID_SECRET=replace_me

# sandbox, development, or production
PLAID_ENV=sandbox

# One of the two encryption settings is required.
DATA_ENCRYPTION_KEYRING={"v1":"replace_with_key_material"}
# DATA_ENCRYPTION_MASTER_KEY=replace_me

# At least one of these three must be non-empty for startup validation.
# Command parsing calls Anthropic only when ANTHROPIC_API_KEY is set.
# This repo does not call the OpenAI API.
ANTHROPIC_API_KEY=replace_me
# OPENAI_API_KEY=replace_me
# CLAUDE_API_KEY=replace_me

# ─── Stripe (optional extras) ───────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_ENABLE_CASHAPP_PAY=false

# ─── App URL (optional; used for OAuth and redirects) ───────────
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# APP_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Postgres pool (optional) ───────────────────────────
# DATABASE_POOL_MAX=1
# DATABASE_POOL_IDLE_TIMEOUT_MS=5000
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
# DATABASE_POOLER_MODE=transaction
# DATABASE_AUTO_ENSURE_SCHEMA=false

# ─── Anthropic model override (optional) ───────────────────
# CLAUDE_MODEL=
# CLAUDE_MODEL_FALLBACKS=

# ─── Receipt parsing (optional) ───────────────────────────
# GEMINI_API_KEY=replace_me
# GOOGLE_API_KEY=replace_me
# GEMINI_MODEL=
# GEMINI_MODEL_FALLBACKS=

# ─── Tiny Fish web actions (optional; both required to execute) ─────
# TINY_FISH_API_URL=
# TINY_FISH_API_KEY=replace_me

# ─── Google and Apple sign-in (optional) ────────────────────
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=
# APPLE_OAUTH_CLIENT_ID=
# APPLE_OAUTH_REDIRECT_URI=

# ─── Plaid extras (optional) ────────────────────────────
# PLAID_WEBHOOK_URL=
# PLAID_REDIRECT_URI=
# PLAID_WEBHOOK_SHARED_SECRET=

# ─── Feedback email and error reporting (optional) ──────────
# RESEND_API_KEY=replace_me
# FEEDBACK_TO_EMAIL=
# SENTRY_DSN=

# ─── Transaction guardrail overrides (optional) ─────────────
# TRANSACTION_MAX_AMOUNT=
# TRANSACTION_DAILY_SPENDING_LIMIT=
# TRANSACTION_CONFIRMATION_THRESHOLD=
# TRANSACTION_ALLOWED_MERCHANTS=
# TRANSACTION_ALLOWED_CATEGORIES=

# ─── Secrets vault (optional; do not commit real JSON) ──────────
# SECRETS_VAULT_PATH=
# SECRETS_VAULT_JSON=

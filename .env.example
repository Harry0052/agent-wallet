# Agent Wallet Environment Variables
# Server-only vars (never expose secrets to client)
DATABASE_URL=postgres://user:password@localhost:5432/agent_wallet
# Optional wallet namespace for multi-tenant/shared DB setups
WALLET_USER_ID=default-user

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: enable Checkout Cash App Pay if enabled in your Stripe account
STRIPE_ENABLE_CASHAPP_PAY=false

TINYFISH_API_KEY=sk-tinyfish-...
TINYFISH_API_BASE_URL=https://api.tinyfish.ai/v1
# Optional endpoint overrides
# TINYFISH_VENDOR_RESEARCH_PATH=/vendor-research
# TINYFISH_PURCHASE_PREPARE_PATH=/purchase/prepare
# TINYFISH_PURCHASE_CONFIRM_PATH=/purchase/confirm
# TINYFISH_SUBSCRIPTION_OPERATION_PATH=/subscription/operation

# Core
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<db>"
DATABASE_POOL_MAX=1
DATABASE_POOL_IDLE_TIMEOUT_MS=5000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
# In production/serverless this should usually stay false after migrations are applied.
DATABASE_AUTO_ENSURE_SCHEMA=false
WALLET_USER_ID=default-user


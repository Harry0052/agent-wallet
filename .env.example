# ─── Plaid Configuration ─────────────────────────────────────────────
# Required: Get these from https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret

# Required: "sandbox", "development", or "production"
PLAID_ENV=sandbox

# Optional: Webhook URL for transaction/item updates (must be publicly accessible)
# PLAID_WEBHOOK_URL=https://your-domain.com/api/connect/transactions/webhook

# Optional: OAuth redirect URI (must match Plaid dashboard config)
# Required if supporting OAuth-based institutions (e.g. Chase, Capital One)
# PLAID_REDIRECT_URI=https://your-domain.com/plaid/oauth

# Optional: Shared secret for webhook signature verification
# PLAID_WEBHOOK_SHARED_SECRET=your_webhook_shared_secret

# ─── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/calico

# ─── Authentication ──────────────────────────────────────────────────
AUTH_SESSION_SECRET=your_session_secret_at_least_32_chars

# ─── Encryption ──────────────────────────────────────────────────────
# At least one of these is required:
DATA_ENCRYPTION_KEYRING=your_encryption_keyring_json
# DATA_ENCRYPTION_MASTER_KEY=your_master_key

# ─── Stripe ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── AI Provider (at least one required) ─────────────────────────────
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_API_KEY=sk-ant-...

# ─── Optional: Secrets Vault ─────────────────────────────────────────
# Load secrets from a JSON file or inline JSON instead of env vars
# SECRETS_VAULT_PATH=./secrets.json
# SECRETS_VAULT_JSON={"PLAID_CLIENT_ID":"...","PLAID_SECRET":"..."}
